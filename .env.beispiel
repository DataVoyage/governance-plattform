# Vorlage fuer eine lokale `.env` neben der docker-compose.yml.
# Kopieren und anpassen:  cp .env.beispiel .env
#
# `.env` ist bewusst nicht im Repository — sie traegt Adressen der jeweiligen
# Umgebung, und die gehoeren nicht in den Quellstand.

# --- Herkunft der Basisimages ---------------------------------------------
# Alle vier Basisimages — python, node, nginx, postgres — kommen aus Docker
# Hub, sofern hier nichts steht. Wo der Zugang dorthin gesperrt ist, zeigt die
# Variable auf den internen Spiegel. Der abschliessende Schraegstrich gehoert
# zum Wert.
#GP_BASIS_PRAEFIX=artifactory.beispiel-ag.de/docker-remote/

# --- Ziel der selbst gebauten Images --------------------------------------
#GP_IMAGE_REGISTRY=artifactory.beispiel-ag.de/governance
#GP_IMAGE_TAG=dev

# --- Erstzugang ------------------------------------------------------------
# Dieses Subject erhaelt bei der ersten Anmeldung App-Administrator und
# Governance. Ohne einen Startpunkt koennte niemand Rollen vergeben.
#GP_BOOTSTRAP_ADMIN_SUBJECTS=vorname.nachname
