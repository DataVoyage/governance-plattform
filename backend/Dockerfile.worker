# Eigenes Image fuer den Sync-Worker (Architektur 6.2): derselbe Code, anderer
# Lebenszyklus — als Kubernetes-CronJob/Job je Adapter ausgefuehrt.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev
COPY app ./app
RUN uv sync --frozen --no-dev


FROM python:3.12-slim-bookworm AS runtime

RUN useradd --create-home --uid 10001 governance
WORKDIR /app
COPY --from=build /app /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
USER governance
ENTRYPOINT ["python", "-m", "app.sync.worker"]
